# ── Required ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev default (omit DATABASE_URL): sqlite:///./data/supportbot.db
# Production (Supabase): use the "Transaction" pooler URL on port 6543 from
# Supabase → Settings → Database → Connection string → URI.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# ── App URL (used for credentialed CORS on admin endpoints) ───────────────────
# Dev: http://localhost:8000
# Prod: your public URL


# ── Multi-tenant Auth (required) ───────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# ── Notifications (optional) ───────────────────────────────────────────────────
# Telegram — for escalation alerts and scheduled reports
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# EmailJS — for email escalation notifications
ZOHO_SMTP_USER      = your@zohomail.com
ZOHO_SMTP_PASSWORD  = your-app-password
ZOHO_SMTP_HOST      = smtp.zoho.com
ZOHO_SMTP_PORT      = 465

# WhatsApp via Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+1234567890

# ── Auto-Healing (optional) ────────────────────────────────────────────────────
# Enable Claude-powered auto-diagnosis of errors
AUTO_HEAL_ENABLED=true
# How often to run the background health check (minutes)
HEALTH_CHECK_INTERVAL_MINUTES=15
# Max times to retry a failing operation before giving up
MAX_HEAL_RETRIES=2

# ── Environment flag (set to "dev" to disable boot guard) ─────────────────────
ENV=production
APP_URL=
COOKIE_SECURE=true
